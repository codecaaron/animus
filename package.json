{
  "name": "root",
  "private": true,
  "workspaces": [
    "packages/_assertions",
    "packages/_parity",
    "packages/_integration",
    "packages/_typescript-5.9",
    "packages/cli",
    "packages/extract",
    "packages/next-plugin",
    "packages/layergate",
    "packages/oracle",
    "packages/properties",
    "packages/showcase",
    "packages/system",
    "packages/test-ds",
    "packages/unplugin",
    "packages/vite-plugin",
    "e2e/next-app",
    "e2e/next16-app",
    "e2e/vite-app",
    "e2e/vinext-app",
    "e2e/react-router-app",
    "e2e/rollup-app",
    "e2e/svelte-app"
  ],
  "type": "module",
  "scripts": {
    "rebuild": "vp run clean:full && vp run build:all",
    "test": "bunx vp test run",
    "verify:browser-fixtures": "bun scripts/browser-fixtures/run.ts",
    "deploy:showcase": "bun run --filter '@animus-ui/showcase' cf:deploy",
    "deploy:vite": "bun run --filter '@animus-ui/vite-app' cf:deploy",
    "deploy:vinext": "bun run --filter '@animus-ui/vinext-app' cf:deploy",
    "deploy:react-router": "bun run --filter '@animus-ui/react-router-app' cf:deploy",
    "dev:showcase": "bun run --filter './packages/showcase' dev",
    "changelog": "bun scripts/changelog/assemble.ts",
    "release": "bash scripts/release.sh"
  },
  "devDependencies": {
    "@animus-ui/assertions": "workspace:*",
    "@arethetypeswrong/cli": "^0.18.5",
    "@jridgewell/trace-mapping": "^0.3.31",
    "@oxlint/plugins": "1.88.0",
    "@types/bun": "1.4.3",
    "@types/lodash": "^4.17.26",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitest/coverage-v8": "5.0.5",
    "csstype": "3.2.3",
    "happy-dom": "^21.0.1",
    "knip": "^6.41.0",
    "oxc-parser": "0.153.0",
    "oxlint": "1.88.0",
    "playwright-core": "1.64.0",
    "publint": "^0.3.25",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tsdown": "^0.23.1",
    "typescript": "7.0.2",
    "vite-plus": "1.3.0",
    "vitest": "5.0.5",
    "wrangler": "4.149.0"
  },
  "overrides": {
    "@babel/core": "7.29.7",
    "browserslist": "4.29.3",
    "fast-uri": "3.1.8",
    "postcss": "8.5.29",
    "vite": "8.3.4"
  },
  "packageManager": "bun@1.4.3"
}
