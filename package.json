{
  "name": "root",
  "private": true,
  "workspaces": [
    "packages/_assertions",
    "packages/_parity",
    "packages/_integration",
    "packages/cli",
    "packages/extract",
    "packages/next-plugin",
    "packages/oracle",
    "packages/properties",
    "packages/showcase",
    "packages/system",
    "packages/test-ds",
    "packages/unplugin",
    "packages/vite-plugin",
    "e2e/next-app",
    "e2e/next16-app",
    "e2e/vite-app",
    "e2e/vinext-app",
    "e2e/react-router-app",
    "e2e/rollup-app",
    "e2e/svelte-app"
  ],
  "type": "module",
  "scripts": {
    "rebuild": "vp run clean:full && vp run build:all",
    "test": "bunx vp test run",
    "deploy:showcase": "bun run --filter '@animus-ui/showcase' cf:deploy",
    "deploy:vite": "bun run --filter '@animus-ui/vite-app' cf:deploy",
    "deploy:vinext": "bun run --filter '@animus-ui/vinext-app' cf:deploy",
    "deploy:react-router": "bun run --filter '@animus-ui/react-router-app' cf:deploy",
    "dev:showcase": "bun run --filter './packages/showcase' dev",
    "release": "bash scripts/release.sh"
  },
  "devDependencies": {
    "@animus-ui/assertions": "workspace:*",
    "@arethetypeswrong/cli": "^0.18.5",
    "@jridgewell/trace-mapping": "^0.3.31",
    "@oxlint/plugins": "1.81.0",
    "@types/bun": "1.3.11",
    "@types/lodash": "^4.17.25",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitest/coverage-v8": "4.1.11",
    "csstype": "3.2.3",
    "happy-dom": "^20.14.0",
    "knip": "^6.34.0",
    "oxc-parser": "0.148.0",
    "oxlint": "1.81.0",
    "publint": "^0.3.24",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "tsdown": "^0.23.0",
    "typescript": "7.0.2",
    "vite-plus": "0.3.0",
    "vitest": "4.1.11",
    "wrangler": "4.129.0"
  },
  "overrides": {
    "@babel/core": "7.29.7",
    "browserslist": "4.28.8",
    "fast-uri": "3.1.7",
    "js-yaml": "4.3.1",
    "postcss": "8.5.28",
    "vite": "8.2.2"
  },
  "packageManager": "bun@1.3.13"
}
