{
  "name": "@animus-ui/extract",
  "version": "0.1.1",
  "description": "Animus static CSS extraction pipeline (Rust/NAPI)",
  "keywords": [
    "animus",
    "compiler",
    "css",
    "css-in-js",
    "napi",
    "rust",
    "static-css",
    "zero-runtime"
  ],
  "homepage": "https://github.com/codecaaron/animus/tree/main/packages/extract#readme",
  "license": "MIT",
  "author": "codecaaron <airrobb@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/codecaaron/animus",
    "directory": "packages/extract"
  },
  "files": [
    "dist",
    "extractor.js",
    "extractor.d.ts",
    "oxlint.d.ts",
    "oxlint.d.mts",
    "crates/extractor/*.node",
    "crates/extractor/index.d.ts"
  ],
  "main": "extractor.js",
  "types": "extractor.d.ts",
  "exports": {
    ".": {
      "import": "./extractor.js",
      "require": "./extractor.js",
      "default": "./extractor.js"
    },
    "./pipeline": {
      "types": "./dist/pipeline/index.d.ts",
      "default": "./dist/index.cjs"
    },
    "./session": {
      "types": "./dist/session/index.d.ts",
      "default": "./dist/session.cjs"
    },
    "./oxlint": {
      "import": {
        "types": "./oxlint.d.mts",
        "default": "./dist/oxlint.mjs"
      },
      "require": {
        "types": "./oxlint.d.ts",
        "default": "./dist/oxlint.cjs"
      }
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "bun run build:v2 && bun run build:ts",
    "build:ts": "tsdown && tsc -p tsconfig.build.json",
    "compile": "bun check -p tsconfig.build.json && bun check -p tsconfig.json",
    "build:v2": "cd crates/extractor && bunx napi build --platform --no-js --release",
    "build:v2:debug": "cd crates/extractor && bunx napi build --platform --no-js"
  },
  "dependencies": {
    "@animus-ui/properties": "workspace:*",
    "browserslist": "^4.28.8",
    "lightningcss": "^1.33.0"
  },
  "devDependencies": {
    "@animus-ui/assertions": "workspace:*",
    "@animus-ui/system": "workspace:*",
    "@napi-rs/cli": "^3.10.8",
    "svelte": "5.57.2"
  },
  "peerDependencies": {
    "svelte": "^5.0.0"
  },
  "peerDependenciesMeta": {
    "svelte": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
